use {{ project_name | replace('-', '_') }}::app::create_app;

use axum::body::Body;
use axum::http::{Request, StatusCode};
use http_body_util::BodyExt;
use serde_json::{Value, json};
use tower::ServiceExt;

const ENTITY_PATH: &str = "/api/v1/{{ entity_plural }}";

async fn request(
    app: axum::Router,
    method: &str,
    url: &str,
    payload: Value,
) -> (StatusCode, Value) {
    let response = app
        .oneshot(
            Request::builder()
                .method(method)
                .uri(url)
                .header("content-type", "application/json")
                .body(Body::from(if payload.is_null() {
                    String::new()
                } else {
                    payload.to_string()
                }))
                .unwrap(),
        )
        .await
        .unwrap();
    let status = response.status();
    let bytes = response.into_body().collect().await.unwrap().to_bytes();
    (
        status,
        if bytes.is_empty() {
            Value::Null
        } else {
            serde_json::from_slice(&bytes).unwrap()
        },
    )
}

#[tokio::test]
async fn item_lifecycle_uses_real_router_and_postgres() {
    let url = std::env::var("DATABASE_URL").expect("Integration tests require DATABASE_URL");
    let admin = sqlx::PgPool::connect(&url).await.unwrap();
    // DDL identifiers cannot be parameters. The fixed prefix + UUID hex are
    // generated locally and contain only ASCII identifier characters.
    let schema = format!("forge_test_{}", uuid::Uuid::new_v4().simple());
    sqlx::query(sqlx::AssertSqlSafe(format!("CREATE SCHEMA {schema}")))
        .execute(&admin)
        .await
        .unwrap();
    let path = schema.clone();
    let pool = sqlx::postgres::PgPoolOptions::new()
        .after_connect(move |connection, _| {
            let path = path.clone();
            Box::pin(async move {
                sqlx::query(sqlx::AssertSqlSafe(format!("SET search_path TO {path}")))
                    .execute(connection)
                    .await?;
                Ok(())
            })
        })
        .connect(&url)
        .await
        .unwrap();
    sqlx::raw_sql(include_str!("../migrations/0001_initial.sql"))
        .execute(&pool)
        .await
        .unwrap();
    let app = create_app(pool.clone());
    let (status, item) = request(
        app.clone(),
        "POST",
        ENTITY_PATH,
        json!({"name": "Lifecycle", "description": "test", "tags": ["test"]}),
    )
    .await;
    assert_eq!(status, StatusCode::CREATED, "{item}");
    let id = item["id"].as_str().unwrap();
    let endpoint = format!("{ENTITY_PATH}/{id}");
    assert_eq!(
        request(app.clone(), "GET", &endpoint, Value::Null).await.1["name"],
        "Lifecycle"
    );
    assert_eq!(
        request(
            app.clone(),
            "POST",
            ENTITY_PATH,
            json!({"name":"Lifecycle"})
        )
        .await
        .0,
        StatusCode::CONFLICT
    );
    let (status, updated) = request(app.clone(), "PATCH", &endpoint, json!({"name": "Updated", "status": "ACTIVE", "tags": ["updated"], "description": "changed"})).await;
    assert_eq!(status, StatusCode::OK, "{updated}");
    assert_eq!(updated["name"], "Updated");
    let (status, page) = request(
        app.clone(),
        "GET",
        &format!("{ENTITY_PATH}?search=Updated&status=ACTIVE&limit=10&skip=0"),
        Value::Null,
    )
    .await;
    assert_eq!(status, StatusCode::OK);
    assert_eq!(page["total"], 1);
    assert_eq!(
        request(
            app.clone(),
            "GET",
            &format!("{ENTITY_PATH}?limit=0"),
            Value::Null
        )
        .await
        .0,
        StatusCode::UNPROCESSABLE_ENTITY
    );
    assert_eq!(
        request(app.clone(), "DELETE", &endpoint, Value::Null)
            .await
            .0,
        StatusCode::NO_CONTENT
    );
    assert_eq!(
        request(app.clone(), "GET", &endpoint, Value::Null).await.0,
        StatusCode::NOT_FOUND
    );
    assert_eq!(
        request(app.clone(), "DELETE", &endpoint, Value::Null)
            .await
            .0,
        StatusCode::NOT_FOUND
    );
    assert_eq!(
        request(app, "PATCH", &endpoint, json!({"name":"gone"}))
            .await
            .0,
        StatusCode::NOT_FOUND
    );
    pool.close().await;
    sqlx::query(sqlx::AssertSqlSafe(format!("DROP SCHEMA {schema} CASCADE")))
        .execute(&admin)
        .await
        .unwrap();
    admin.close().await;
}
