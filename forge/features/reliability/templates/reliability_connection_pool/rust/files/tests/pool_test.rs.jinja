use {{ project_name | replace('-', '_') }}::db_pool::build_pool;

#[tokio::test]
async fn configured_pool_executes_database_queries() {
    let url = std::env::var("DATABASE_URL").expect("Pool tests require DATABASE_URL");
    let pool = build_pool(&url).await.unwrap();
    let value: i32 = sqlx::query_scalar("SELECT 42")
        .fetch_one(&pool)
        .await
        .unwrap();
    assert_eq!(value, 42);
    pool.close().await;
}
